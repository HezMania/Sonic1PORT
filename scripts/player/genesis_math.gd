static func s16(value: int) -> int:
	value &= 0xFFFF
	return value - 0x10000 if value >= 0x8000 else value

static func u16(value: int) -> int:
	return value & 0xFFFF

static func s8(value: int) -> int:
	value &= 0xFF
	return value - 0x100 if value >= 0x80 else value

static func u8(value: int) -> int:
	return value & 0xFF

static func mul_shift8(a: int, b: int) -> int:
	return s16((a * b) >> 8)

static func sine(angle: int) -> int:
	return SINE[angle & 0xFF]

static func cosine(angle: int) -> int:
	return SINE[(angle + 0x40) & 0xFF]

static func calc_angle(x: int, y: int) -> int:
	# Direct high-level equivalent of the original CalcAngle lookup routine.
	var sx := s16(x)
	var sy := s16(y)
	if sx == 0 and sy == 0:
		return 0x40
	var ax := absi(sx)
	var ay := absi(sy)
	var result: int
	if ay >= ax:
		var ratio: int = 0x100 if ay == 0 else mini(0x100, int((ax << 8) / ay))
		result = 0x40 - ANGLE[ratio]
	else:
		var ratio: int = mini(0x100, int((ay << 8) / ax))
		result = ANGLE[ratio]
	if sx < 0:
		result = -result + 0x80
	if sy < 0:
		result = -result + 0x100
	return result & 0xFF

static func approach_zero(value: int, amount: int) -> int:
	if value > 0:
		return maxi(0, value - amount)
	if value < 0:
		return mini(0, value + amount)
	return 0
