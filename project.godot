; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sonic 1 PC - SFX Fidelity Phase 54"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[audio]

sonic/output_mode="clean"
sonic/waterfall_sfx_enabled=true

[autoload]

Global="*res://scripts/global.gd"
SonicAudio="*res://scripts/audio/sonic_audio.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=224
window/size/window_width_override=960
window/size/window_height_override=672
window/stretch/mode="canvas_items"

